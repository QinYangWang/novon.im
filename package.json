{
  "name": "novon",
  "version": "0.1.0",
  "description": "novon — a static blog & documentation generator powered by bun, vite, react and shadcn/ui (base-ui)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "novon": "./bin/novon.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./plugin": {
      "types": "./src/plugins/api.ts",
      "default": "./src/plugins/api.ts"
    },
    "./theme.css": "./src/runtime/theme.css",
    "./runtime/*": "./src/runtime/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "unist-util-mdx-define": "^1.1.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
