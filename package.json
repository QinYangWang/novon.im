{
  "name": "novon",
  "version": "0.1.0",
  "description": "novon \u2014 a static blog & documentation generator powered by bun, vite, react and react-aria-components",
  "type": "module",
  "license": "MIT",
  "bin": {
    "novon": "./bin/novon.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    ".agents/skills",
    "AGENTS.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./plugin": {
      "types": "./src/plugins/api.ts",
      "default": "./src/plugins/api.ts"
    },
    "./theme.css": "./src/runtime/theme.css",
    "./runtime/*": "./src/runtime/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "lint": "oxlint",
    "test": "bun test",
    "test:browser": "node tests/navigation.browser.mjs",
    "test:stylex": "node tests/stylex.browser.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@vitejs/plugin-react": "^6.1.1",
    "blobatar": "^2.7.0",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "satori": "^0.33.4",
    "shiki": "^4.4.3",
    "unist-util-mdx-define": "^1.1.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
